# Snowflake connection details — the contract between every tool in this repo.
#
# Copy to .env (gitignored) and fill in real values:
#     cp .env.example .env
#
# Nothing sources .env automatically. Load it into the shell before any command
# that touches Snowflake — `set -a` exports every assignment that follows:
#     set -a; source .env; set +a
#
# Then: python -m src.bronze.load_online_retail
#       dbt build
#
# Never put real values in this file. It is tracked, and
# src/scripts/check_no_secrets.py will reject a literal account host or password.

# --- Account -----------------------------------------------------------------
# Org-account identifier, e.g. myorg-myaccount. NOT the full
# <...>.snowflakecomputing.com host, and not a URL.
SNOWFLAKE_ACCOUNT=

# --- Warehouse / role / database ---------------------------------------------
# Role needs CREATE GIT REPOSITORY, CREATE STREAMLIT and CORTEX usage.
SNOWFLAKE_ROLE=
SNOWFLAKE_WAREHOUSE=
SNOWFLAKE_DATABASE=EXPERT_TALK

# --- Credentials: dbt (profiles.yml dev target) -------------------------------
# This account has no SAML IdP, so externalbrowser SSO fails at auth and these
# are password auth. See the comment in dbt/profiles.yml.
SNOWFLAKE_USER=
SNOWFLAKE_PASSWORD=

# --- Credentials: Bronze loader -----------------------------------------------
# src/bronze/load_online_retail.py reads TEST_-prefixed names, not the pair
# above. The two names are the same principal today; the loader just never got
# renamed. Set both to the same values until that drift is fixed.
TEST_SNOWFLAKE_USER=
TEST_SNOWFLAKE_PASSWORD=

# --- CI only (profiles.yml ci target) ------------------------------------------
# Key-pair auth for the service user. Unset locally; GitHub Actions supplies
# these from secrets. *.p8 and *.pem are gitignored.
# SNOWFLAKE_PRIVATE_KEY_PATH=
# SNOWFLAKE_PRIVATE_KEY_PASSPHRASE=
