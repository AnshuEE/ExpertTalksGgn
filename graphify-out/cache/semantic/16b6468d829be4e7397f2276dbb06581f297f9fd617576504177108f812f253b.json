{"nodes": [{"id": "docs_facilitator_runbook", "label": "Facilitator Runbook", "file_type": "document", "source_file": "docs/FACILITATOR_RUNBOOK.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "concept_a_prefix_bad_debt", "label": "A-prefix 'Adjust bad debt' rows", "file_type": "rationale", "source_file": "docs/FACILITATOR_RUNBOOK.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Three rows with an 'A' InvoiceNo prefix ('Adjust bad debt') are non-revenue like the well-known 'C'-prefix cancellations, but are easy to miss because a naive `not like 'C%'` filter passes every test, and the three rows' signed amounts (+1, -2) nearly cancel out \u2014 a leaked total looks almost right instead of obviously wrong. Illustrates that a prefix convention observed in a few rows is a pattern, not a verified rule."}, {"id": "concept_four_beats_demo", "label": "Four-beat demo structure", "file_type": "rationale", "source_file": "docs/FACILITATOR_RUNBOOK.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The live session is four beats: Beat 1 commits the harness with no pipeline code yet; Beats 2-3 build Bronze and profile with Cortex under human supervision, catching real defects; Beat 4 discards that supervised work, branches fresh, and lets one long prompt build the entire pipeline unattended. The comparison is deliberately unfair to demonstrate that the harness, not model capability, is what changed."}], "edges": [{"source": "docs_facilitator_runbook", "target": "concept_dtype_str_bronze_loading", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/FACILITATOR_RUNBOOK.md", "source_location": null, "weight": 1.0}, {"source": "docs_facilitator_runbook", "target": "concept_harness", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/FACILITATOR_RUNBOOK.md", "source_location": "L5-9", "weight": 1.0}, {"source": "docs_facilitator_runbook", "target": "claude", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/FACILITATOR_RUNBOOK.md", "source_location": "L235", "weight": 1.0}, {"source": "docs_facilitator_runbook", "target": "agents", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/FACILITATOR_RUNBOOK.md", "source_location": "L216", "weight": 1.0}, {"source": "docs_facilitator_runbook", "target": "docs_ai_review_checklist", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/FACILITATOR_RUNBOOK.md", "source_location": "L277", "weight": 1.0}, {"source": "docs_facilitator_runbook", "target": "create_dbt_model_skill", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/FACILITATOR_RUNBOOK.md", "source_location": "L254-264", "weight": 1.0}, {"source": "docs_facilitator_runbook", "target": "concept_four_beats_demo", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/FACILITATOR_RUNBOOK.md", "source_location": "L167-197", "weight": 1.0}, {"source": "docs_facilitator_runbook", "target": "concept_a_prefix_bad_debt", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/FACILITATOR_RUNBOOK.md", "source_location": "L466-517", "weight": 1.0}], "hyperedges": []}